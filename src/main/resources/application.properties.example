# Template for src/main/resources/application.properties (which is gitignored).
# Copy to application.properties. Contains no secrets - every credential is read
# from .env / the environment.
#
# Environment-specific values live in the committed profile files next to this one:
#   application-dev.properties   - localhost infrastructure, verbose logging
#   application-prod.properties  - all connection details from the environment

spring.application.name=code-review-platform

# Load .env from the working directory when present, so a local `mvn spring-boot:run`
# gets the same values docker-compose injects as real environment variables.
# `optional:` keeps startup working in the container, where no .env is shipped.
spring.config.import=optional:file:.env[.properties]

# Profile used when nothing sets SPRING_PROFILES_ACTIVE / -Dspring-boot.run.profiles,
# so a bare `mvn spring-boot:run` and `mvn test` behave like they did before profiles
# existed. docker-compose sets SPRING_PROFILES_ACTIVE=prod, which overrides this.
spring.profiles.default=dev

# ---------------------------------------------------------------------------
# JPA
# ---------------------------------------------------------------------------
# ddl-auto stays shared: prod is still bootstrapped from an empty volume by
# docker-compose, so `validate` would fail on first start. Tightening this
# belongs with introducing a schema migration tool, not with profiles.
spring.jpa.hibernate.ddl-auto=update

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# ---------------------------------------------------------------------------
# Messaging
# ---------------------------------------------------------------------------
# A chunk that fails is already recorded as FAILED in the database, so requeueing it would only
# redeliver the same poison message forever. Retry and dead-lettering are a later milestone.
spring.rabbitmq.listener.simple.default-requeue-rejected=false

# ---------------------------------------------------------------------------
# Secrets and application settings
# ---------------------------------------------------------------------------
# Secrets are deliberately left without a default: a fallback value here would silently
# ship a known signing key / missing credential instead of failing at startup.
app.jwt.secret=${JWT_SECRET_KEY}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:36000000}

gemini.api.key=${GEMINI_API_KEY}
gemini.api.url=${GEMINI_API_URL:https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent}

app.upload-dir=${APP_UPLOAD_DIR:uploads}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

app.repository.temp-dir=${APP_REPOSITORY_TEMP_DIR:temp-repositories}

app.ai.max-chunk-size=${APP_AI_MAX_CHUNK_SIZE:20000}

# ---------------------------------------------------------------------------
# Actuator
# ---------------------------------------------------------------------------
management.endpoints.web.exposure.include=health,info
