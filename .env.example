# ---------------------------------------------------------------------------
# Local / docker-compose configuration. NOT committed (see .gitignore).
# Template: copy to .env and fill in real values. Safe to commit.
#
# Read by two independent consumers:
#   - docker-compose, for ${VAR} substitution in docker-compose.yml
#   - Spring Boot, via `spring.config.import` in application.properties
#     (so `mvn spring-boot:run` picks these up too)
# ---------------------------------------------------------------------------

# --- PostgreSQL container ---
POSTGRES_DB=aicode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# --- Datasource used by the application ---
# Host is localhost for a local run; docker-compose overrides DB_* for the
# backend container so it points at the `postgres` service instead.
DB_URL=jdbc:postgresql://localhost:5432/aicode
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# --- RabbitMQ ---
# RABBITMQ_HOST is overridden to `rabbitmq` inside docker-compose.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Auth / JWT ---
# HS256 signing key: must be at least 32 bytes. Rotating it invalidates all
# tokens already issued.
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRATION_MS=36000000

# --- Google Gemini ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# --- Application ---
APP_UPLOAD_DIR=uploads
APP_REPOSITORY_TEMP_DIR=temp-repositories
APP_AI_MAX_CHUNK_SIZE=20000

# --- Not wired up yet ---
# No code reads this: repositories are cloned anonymously, so only public
# repos work today. Left here as the intended name for private-repo cloning.
# GITHUB_TOKEN=
